<Window x:Class="RestoPro.Views.RaportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raport Sumar Restaurant"
        Height="560" Width="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Raport Sumar Restaurant — RestoPro"
                   FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Tabel sumar per masă -->
        <DataGrid Grid.Row="1" x:Name="DgRaport"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr. Masă"
                    Binding="{Binding NumarMasa}" Width="90"/>
                <DataGridTextColumn Header="Zonă"
                    Binding="{Binding Zona}" Width="120"/>
                <DataGridTextColumn Header="Nr. Comenzi"
                    Binding="{Binding NrComenzi}" Width="100"/>
                <DataGridTextColumn Header="Total Achitat (lei)"
                    Binding="{Binding TotalAchitat,
                    StringFormat={}{0:F2}}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Statistici generale -->
        <Border Grid.Row="2" Background="#ECF0F1"
                CornerRadius="4" Padding="12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock x:Name="TxtTotalComenzi"
                           FontSize="13" Margin="0,2"/>
                <TextBlock x:Name="TxtTotalIncasat"
                           FontSize="13" Margin="0,2"/>
                <TextBlock x:Name="TxtMediaMasa"
                           FontSize="13" Margin="0,2"/>
                <TextBlock x:Name="TxtProdusCelMaiVandut"
                           FontSize="13" Margin="0,2"/>
            </StackPanel>
        </Border>

        <!-- Butoane -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="Export TXT" Width="110" Height="32"
                    Margin="0,0,10,0" Click="BtnExport_Click"
                    Background="#2980B9" Foreground="White"/>
            <Button Content="Închide" Width="90" Height="32"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>