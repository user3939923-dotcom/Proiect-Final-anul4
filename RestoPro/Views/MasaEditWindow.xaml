<Window x:Class="RestoPro.Views.MasaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masă" Height="280" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   x:Name="TitleText" Text="Adaugă Masă"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Nr. Masă:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="TxtNumar" Height="28" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="Capacitate:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 x:Name="TxtCapacitate" Height="28"
                 Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="Zonă:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1"
                  x:Name="CbZona" Height="28" Margin="0,0,0,15">
            <ComboBoxItem Content="Terasa"/>
            <ComboBoxItem Content="Interior"/>
            <ComboBoxItem Content="Salon Privat"/>
        </ComboBox>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Salvează" Width="90" Height="30"
                    Margin="0,0,10,0" Click="BtnSave_Click"
                    Background="#27AE60" Foreground="White"/>
            <Button Content="Anulează" Width="90" Height="30"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>