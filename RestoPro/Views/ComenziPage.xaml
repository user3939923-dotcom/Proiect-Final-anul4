<Page x:Class="RestoPro.Views.ComenziPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Comenzi">
    <Grid Margin="20" Height="241" Width="410">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestionare Comenzi"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Filtre -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Margin="0,0,0,10">
            <TextBlock Text="Masă:" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="CbFilterMasa" Width="120"
                      Height="28" Margin="0,0,15,0"
                      SelectionChanged="CbFilter_Changed"/>
            <TextBlock Text="Status:" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="CbFilterStatus" Width="120"
                      Height="28"
                      SelectionChanged="CbFilter_Changed">
                <ComboBoxItem Content="Toate"/>
                <ComboBoxItem Content="Achitat"/>
                <ComboBoxItem Content="Neachitat"/>
            </ComboBox>
        </StackPanel>

        <!-- Tabel comenzi -->
        <DataGrid Grid.Row="2" x:Name="DgComenzi"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgComenzi_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                    Binding="{Binding IdComanda}" Width="50"/>
                <DataGridTextColumn Header="Masă"
                    Binding="{Binding NumarMasa}" Width="80"/>
                <DataGridTextColumn Header="Produs"
                    Binding="{Binding DenumireProdus}"
                    Width="160"/>
                <DataGridTextColumn Header="Data"
                    Binding="{Binding DataComanda,
                    StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Cant."
                    Binding="{Binding Cantitate}" Width="60"/>
                <DataGridTextColumn Header="Preț Unit."
                    Binding="{Binding PretProdus,
                    StringFormat={}{0:F2}}" Width="90"/>
                <DataGridTextColumn Header="Total"
                    Binding="{Binding Total,
                    StringFormat={}{0:F2}}" Width="90"/>
                <DataGridTextColumn Header="Status Plată"
                    Binding="{Binding StatusPlata}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button Content="Adaugă Comandă" Width="140"
                    Height="32" Margin="0,0,8,0"
                    Click="BtnAdd_Click"
                    Background="#27AE60" Foreground="White"/>
            <Button Content="Anulează Comandă" Width="140"
                    Height="32" Click="BtnDelete_Click"
                    x:Name="BtnDelete" IsEnabled="False"
                    Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>