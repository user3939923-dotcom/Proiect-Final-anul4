<Page x:Class="RestoPro.Views.MasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mese">
    <Grid Margin="20" Height="217" Width="473">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestionare Mese"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" x:Name="DgMese"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                    Binding="{Binding IdMasa}" Width="60"/>
                <DataGridTextColumn Header="Nr. Masă"
                    Binding="{Binding NumarMasa}" Width="100"/>
                <DataGridTextColumn Header="Capacitate"
                    Binding="{Binding Capacitate}" Width="100"/>
                <DataGridTextColumn Header="Zonă"
                    Binding="{Binding Zona}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>