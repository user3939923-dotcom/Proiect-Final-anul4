<Page x:Class="RestoPro.Views.MasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mese" Height="324" Width="520">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestionare Mese"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Bara de căutare -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Margin="0,0,0,10">
            <TextBlock Text="Caută:" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSearch" Width="200" Height="28"
                     Margin="0,0,8,0"/>
            <Button Content="Caută" Width="80" Height="28"
                    Click="BtnSearch_Click"/>
            <Button Content="Resetează" Width="90" Height="28"
                    Margin="8,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>

        <!-- Tabel date -->
        <DataGrid Grid.Row="2" x:Name="DgMese"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgMese_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                    Binding="{Binding IdMasa}" Width="60"/>
                <DataGridTextColumn Header="Nr. Masă"
                    Binding="{Binding NumarMasa}" Width="120"/>
                <DataGridTextColumn Header="Capacitate"
                    Binding="{Binding Capacitate}" Width="120"/>
                <DataGridTextColumn Header="Zonă"
                    Binding="{Binding Zona}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Butoane CRUD -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button Content="Adaugă" Width="100" Height="32"
                    Margin="0,0,8,0" Click="BtnAdd_Click"
                    Background="#27AE60" Foreground="White"/>
            <Button Content="Modifică" Width="100" Height="32"
                    Margin="0,0,8,0" Click="BtnEdit_Click"
                    x:Name="BtnEdit" IsEnabled="False"
                    Background="#2980B9" Foreground="White"/>
            <Button Content="Șterge" Width="100" Height="32"
                    Click="BtnDelete_Click" x:Name="BtnDelete"
                    IsEnabled="False"
                    Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>