<Page x:Class="RestoPro.Views.ProdusePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Produse">
    <Grid Height="246" Width="629">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestionare Produse din Meniu"
                   FontSize="20" FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Filtre -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    Margin="0,0,0,10">
            <TextBlock Text="Categorie:" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="CbFilterCategorie" Width="140"
                      Height="28" Margin="0,0,10,0"
                      SelectionChanged="CbFilter_Changed"/>
            <TextBlock Text="Caută:" VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSearch" Width="180" Height="28"
                     Margin="0,0,8,0"/>
            <Button Content="Caută" Width="80" Height="28"
                    Click="BtnSearch_Click"/>
            <Button Content="Resetează" Width="90" Height="28"
                    Margin="8,0,0,0" Click="BtnReset_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DgProduse"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="DgProduse_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                    Binding="{Binding IdProdus}" Width="50"/>
                <DataGridTextColumn Header="Denumire"
                    Binding="{Binding Denumire}" Width="180"/>
                <DataGridTextColumn Header="Categorie"
                    Binding="{Binding Categorie}" Width="130"/>
                <DataGridTextColumn Header="Preț (lei)"
                    Binding="{Binding Pret, StringFormat={}{0:F2}}"
                    Width="100"/>
                <DataGridCheckBoxColumn Header="Disponibil"
                    Binding="{Binding Disponibil}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button Content="Adaugă" Width="100" Height="32"
                    Margin="0,0,8,0" Click="BtnAdd_Click"
                    Background="#27AE60" Foreground="White"/>
            <Button Content="Modifică" Width="100" Height="32"
                    Margin="0,0,8,0" Click="BtnEdit_Click"
                    x:Name="BtnEdit" IsEnabled="False"
                    Background="#2980B9" Foreground="White"/>
            <Button Content="Șterge" Width="100" Height="32"
                    Click="BtnDelete_Click" x:Name="BtnDelete"
                    IsEnabled="False"
                    Background="#E74C3C" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>