<Window x:Class="RestoPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestoPro" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bara de navigare -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                    Background="#2C3E50" Height="50">
            <TextBlock Text="🍽 RestoPro" Foreground="White"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="15,0,30,0"/>
            <Button Content="Mese"    Style="{StaticResource NavButton}"
                    Click="BtnMese_Click"/>
            <Button Content="Produse" Style="{StaticResource NavButton}"
                    Click="BtnProduse_Click"/>
            <Button Content="Comenzi" Style="{StaticResource NavButton}"
                    Click="BtnComenzi_Click"/>
            <Button Content="Raport"  Style="{StaticResource NavButton}"
                    Click="BtnRaport_Click"/>
        </StackPanel>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>